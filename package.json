{
  "name": "ecole-esprit-global",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "École Esprit Global (مدرسة العقل العالمي) - Educational Web App",
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=client\" \"npm run dev --workspace=server\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=client",
    "start": "npm run start --workspace=server",
    "lint": "npm run lint --workspace=client"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "devDependencies": {
    "concurrently": "^9.1.2",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^24.43.1"
  }
}
